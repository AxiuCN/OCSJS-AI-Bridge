# OCS AI 桥接服务 · 环境变量示例
#
# 复制为 .env 后填写（.env 已被 .gitignore 排除，不会提交）。
# 真实环境变量优先于本文件：已 export 的值不会被这里的同名项覆盖。
#
# 说明：仓库里不放任何真实地址与密钥是硬约束。这里既包括凭据（令牌、API Key），
# 也包括内网拓扑（Ollama 主机地址）——后者不是密钥，但同样不该进仓库。

# ── 服务自身 ──────────────────────────────────────────────
# 与 config.jsonc 的 server.access_token 对应，也是 OCS 题库配置里要填的令牌。
# 建议用长随机串：下面这行命令可生成一个
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SERVICE_ACCESS_TOKEN=change-me

# 可选：配置文件路径（默认 ./config.jsonc）
# BRIDGE_CONFIG=config.jsonc

# 可选：日志级别 debug | info | warn | error（默认 info）
# BRIDGE_LOG_LEVEL=info

# 可选：收到退出信号后，给正在作答的请求的宽限期（毫秒，默认 30000）。
# 若把 deadline_seconds 调得很小，可相应调小此值以加快重启；
# 同时记得把 deploy/ocs-ai-bridge.service 的 TimeoutStopSec 调到比它更大。
# SHUTDOWN_GRACE_MS=30000

# ── 本地 Ollama 后端 ─────────────────────────────────────
# 这两项是必填：配置文件里只写 ${OLLAMA_BASE_URL} / ${OLLAMA_MODEL} 占位符，
# 示例与模板中不出现任何真实地址。未设置时服务启动会直接失败并指出变量名。
OLLAMA_BASE_URL=http://192.168.1.1:11434
OLLAMA_MODEL=qwen3.5:9b

# ── 在线后端（可选，不启用则不填）────────────────────────
# 只有 config.jsonc 里取消了 openai_responses 后端注释时才需要。
# 未设置且配置中被引用时，启动会明确报错指出字段路径，不会静默降级。
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_API_KEY=sk-your-key
# OPENAI_MODEL=gpt-5.6-sol
