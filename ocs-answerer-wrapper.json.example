[
  {
    "name": "AI 桥接题库",
    "homepage": "https://your-service.example.com/health",
    "url": "https://your-service.example.com/v1/answer",
    "method": "post",
    "contentType": "json",
    "type": "GM_xmlhttpRequest",
    "headers": {
      "Content-Type": "application/json",
      "X-Access-Token": "change-me"
    },
    "data": {
      "title": "${title}",
      "options": "${options}",
      "type": "${type}"
    },
    "handler": "return (res) => res.code === 1 ? [res.question, res.answer] : [res.message || 'AI 桥接题库请求失败', undefined]"
  }
]
